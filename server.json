{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.oddsrelay/oddsrelay-mcp",
  "title": "OddsRelay",
  "description": "Read-only MCP server for OddsRelay odds data, with a token cap on every call that spends tokens.",
  "repository": {
    "url": "https://github.com/oddsrelay/oddsrelay-mcp",
    "source": "github"
  },
  "websiteUrl": "https://oddsrelay.io",
  "version": "0.1.2",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "oddsrelay-mcp",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ODDSRELAY_KEY",
          "description": "Your OddsRelay API key",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
