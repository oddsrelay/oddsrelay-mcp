# Only what the server needs at run time goes into the bundle: everything at the top is left out except these.
/*
!/dist
!/node_modules
!/manifest.json
!/package.json
!/README.md
!/LICENSE

# devDependencies stay out of node_modules in the bundle.
# Listed by hand: add a line for each new devDependency and for what it pulls in. A test checks the direct ones.
node_modules/typescript
node_modules/@types
node_modules/undici-types
node_modules/.package-lock.json
