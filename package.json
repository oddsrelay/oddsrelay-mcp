    "url": "git+https://github.com/oddsrelay/oddsrelay-mcp.git"
  },
  "license": "MIT",
  "author": "OddsRelay <hello@oddsrelay.io> (https://oddsrelay.io)",
  "type": "module",
  "bin": {
    "oddsrelay-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
